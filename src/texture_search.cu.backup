#include "texture_search.cuh"

#include <cuda_runtime.h>

#include <cstdint>


namespace {

constexpr uint64_t MULTIPLIER = 0x5DEECE66DULL;
constexpr uint64_t MASK = (1ULL << 48) - 1ULL;


/*
 * Exact equivalent of:
 *
 * private static long getCoordRandom(int x, int y, int z) {
 *     long l = (long)(x * 3129871)
 *            ^ (long)z * 116129781L
 *            ^ (long)y;
 *
 *     l = l * l * 42317861L + l * 11L;
 *
 *     return l;
 * }
 */
__device__ __forceinline__
int64_t getCoordRandom(
    int x,
    int y,
    int z
)
{
    /*
     * Java:
     *
     * (long)(x * 3129871)
     *
     * Important: x * 3129871 happens as a Java int
     * BEFORE being cast to long.
     */
    int xProduct = x * 3129871;

    /*
     * Java:
     *
     * (long)z * 116129781L
     */
    int64_t l =
        static_cast<int64_t>(xProduct)
        ^
        (
            static_cast<int64_t>(z) *
            116129781LL
        )
        ^
        static_cast<int64_t>(y);


    /*
     * Java long arithmetic wraps at 64 bits.
     *
     * CUDA signed overflow is technically undefined, so
     * perform the multiplication using uint64_t and then
     * reinterpret the resulting bits as int64_t.
     */
    uint64_t u =
        static_cast<uint64_t>(l);

    u =
        u * u * 42317861ULL
        +
        u * 11ULL;

    return static_cast<int64_t>(u);
}


/*
 * Exact equivalent of:
 *
 * getCoordRandom(x, y, z) >> 16
 */
__device__ __forceinline__
int64_t getCoordinateRandom(
    int x,
    int y,
    int z
)
{
    return getCoordRandom(x, y, z) >> 16;
}


/*
 * Exact equivalent of VanillaTextures.getTexture().
 */
__device__ __forceinline__
int getTexture(
    int x,
    int y,
    int z,
    int mod
)
{
    int64_t seed =
        getCoordinateRandom(x, y, z);


    /*
     * seed = seed ^ multiplier
     */
    seed =
        static_cast<int64_t>(
            static_cast<uint64_t>(seed)
            ^
            MULTIPLIER
        );


    /*
     * Java:
     *
     * seed = seed * multiplier + 11L & mask;
     *
     * The multiplication/addition happens as signed long,
     * but the result is then masked to 48 bits.
     */
    uint64_t s =
        static_cast<uint64_t>(seed);

    s =
        (s * MULTIPLIER + 11ULL)
        &
        MASK;


    /*
     * Java:
     *
     * int next = (int)(seed >> 48 - 31);
     *
     * 48 - 31 = 17
     */
    int next =
        static_cast<int>(s >> 17);


    /*
     * Java:
     *
     * (4 * (long)next) >> 31
     */
    int variant =
        static_cast<int>(
            (
                4LL *
                static_cast<int64_t>(next)
            ) >> 31
        );


    /*
     * Java:
     *
     * ... % mod
     */
    return variant % mod;
}


/*
 * Check one candidate.
 */
__device__ __forceinline__
bool matches(
    int x,
    int y,
    int z,

    const RotationInfo* formation,
    int formationSize
)
{
    for (int i = 0; i < formationSize; ++i) {

        const RotationInfo info =
            formation[i];


        const int mod =
            info.isSide
                ? 2
                : 4;


        const int texture =
            getTexture(
                x + info.x,
                y + info.y,
                z + info.z,
                mod
            );


        if (texture != info.rotation) {
            return false;
        }
    }


    return true;
}


/*
 * Grid-stride CUDA kernel.
 */
__global__
void searchKernel(
    int y,

    int xMin,
    int xMax,

    int zMin,
    int zMax,

    const RotationInfo* formation,
    int formationSize,

    int* resultX,
    int* resultZ,

    unsigned int* resultCount,
    unsigned int maxResults
)
{
    const uint64_t width =
        static_cast<uint64_t>(
            static_cast<int64_t>(xMax) -
            static_cast<int64_t>(xMin)
        )
        +
        1ULL;


    const uint64_t height =
        static_cast<uint64_t>(
            static_cast<int64_t>(zMax) -
            static_cast<int64_t>(zMin)
        )
        +
        1ULL;


    const uint64_t total =
        width * height;


    const uint64_t threadId =
        static_cast<uint64_t>(blockIdx.x) *
        static_cast<uint64_t>(blockDim.x)
        +
        static_cast<uint64_t>(threadIdx.x);


    const uint64_t stride =
        static_cast<uint64_t>(gridDim.x) *
        static_cast<uint64_t>(blockDim.x);


    for (
        uint64_t index = threadId;
        index < total;
        index += stride
    ) {

        const int x =
            xMin +
            static_cast<int>(
                index / height
            );


        const int z =
            zMin +
            static_cast<int>(
                index % height
            );


        if (!matches(
                x,
                y,
                z,
                formation,
                formationSize
            )) {

            continue;
        }


        const unsigned int slot =
            atomicAdd(
                resultCount,
                1U
            );


        if (slot < maxResults) {

            resultX[slot] = x;
            resultZ[slot] = z;
        }
    }
}

} // namespace


void launchSearch(
    int y,

    const SearchConfig& config,

    const RotationInfo* dFormation,
    int formationSize,

    int* dResultX,
    int* dResultZ,

    unsigned int* dResultCount,
    unsigned int maxResults,

    cudaStream_t stream
)
{
    /*
     * Reasonable configuration for the RTX 3060 Ti.
     */
    constexpr unsigned int THREADS = 256;

    /*
     * Grid-stride loop means we don't need one block
     * for every section of the search space.
     */
    constexpr unsigned int BLOCKS = 65535;


    searchKernel<<<
        BLOCKS,
        THREADS,
        0,
        stream
    >>>(
        y,

        config.xMin,
        config.xMax,

        config.zMin,
        config.zMax,

        dFormation,
        formationSize,

        dResultX,
        dResultZ,

        dResultCount,
        maxResults
    );
}
