#include "texture_search.cuh"

#include <cuda_runtime.h>

#include <cstdint>
#include <cstddef>
#include <algorithm>


namespace
{

// ============================================================================
// Constants
// ============================================================================

constexpr uint64_t MULTIPLIER = 0x5DEECE66DULL;
constexpr uint64_t MASK       = (1ULL << 48) - 1ULL;

// Keep comfortably below CUDA's 64 KiB constant-memory limit.
constexpr int MAX_CONSTANT_FORMATION = 1024;

__constant__
RotationInfo cFormation[MAX_CONSTANT_FORMATION];


// ============================================================================
// Exact Java-compatible coordinate RNG
// ============================================================================

__device__ __forceinline__
int64_t getCoordRandom(
    int x,
    int y,
    int z
)
{
    // Java performs this multiplication as int before casting to long.
    const int xProduct =
        x * 3129871;

    uint64_t l =
        static_cast<uint64_t>(
            static_cast<int64_t>(xProduct)
        )
        ^
        static_cast<uint64_t>(
            static_cast<int64_t>(z) *
            116129781LL
        )
        ^
        static_cast<uint64_t>(
            static_cast<int64_t>(y)
        );

    // Java long overflow = modulo 2^64.
    l =
        l * l * 42317861ULL
        +
        l * 11ULL;

    return static_cast<int64_t>(l);
}


__device__ __forceinline__
uint64_t getCoordinateRandom(
    int x,
    int y,
    int z
)
{
    const int64_t value =
        getCoordRandom(x, y, z) >> 16;

    return
        static_cast<uint64_t>(value)
        &
        MASK;
}


// ============================================================================
// Vanilla texture RNG
// ============================================================================

__device__ __forceinline__
int nextRandom31(
    int x,
    int y,
    int z
)
{
    uint64_t seed =
        getCoordinateRandom(
            x,
            y,
            z
        );

    seed ^=
        MULTIPLIER;

    seed =
        (
            seed * MULTIPLIER
            +
            11ULL
        )
        &
        MASK;

    return static_cast<int>(
        seed >> 17
    );
}


__device__ __forceinline__
int getTexture4(
    int x,
    int y,
    int z
)
{
    const int next =
        nextRandom31(
            x,
            y,
            z
        );

    return static_cast<int>(
        (
            4LL *
            static_cast<int64_t>(next)
        )
        >>
        31
    );
}


__device__ __forceinline__
int getTexture2(
    int x,
    int y,
    int z
)
{
    const int next =
        nextRandom31(
            x,
            y,
            z
        );

    const int variant =
        static_cast<int>(
            (
                4LL *
                static_cast<int64_t>(next)
            )
            >>
            31
        );

    return variant & 1;
}


// ============================================================================
// Formation matching
// ============================================================================

/*
 * Formation geometry is completely generic.
 *
 * We don't assume:
 * - number of entries
 * - X/Z/Y spacing
 * - shape
 * - orientation
 *
 * We only separate mod-4 and mod-2 entries so the more selective mod-4
 * checks can reject candidates first.
 */

__device__ __forceinline__
bool matchesConstant(
    int x,
    int y,
    int z,
    int formationSize
)
{
    // Mod 4 checks first.
    for (int i = 0; i < formationSize; ++i) {

        const RotationInfo info =
            cFormation[i];

        if (info.isSide) {
            continue;
        }

        const int texture =
            getTexture4(
                x + info.x,
                y + info.y,
                z + info.z
            );

        if (texture != info.rotation) {
            return false;
        }
    }

    // Mod 2 checks second.
    for (int i = 0; i < formationSize; ++i) {

        const RotationInfo info =
            cFormation[i];

        if (!info.isSide) {
            continue;
        }

        const int texture =
            getTexture2(
                x + info.x,
                y + info.y,
                z + info.z
            );

        if (texture != info.rotation) {
            return false;
        }
    }

    return true;
}


__device__ __forceinline__
bool matchesGlobal(
    int x,
    int y,
    int z,

    const RotationInfo* __restrict__ formation,
    int formationSize
)
{
    // Mod 4 checks first.
    for (int i = 0; i < formationSize; ++i) {

        const RotationInfo info =
            formation[i];

        if (info.isSide) {
            continue;
        }

        const int texture =
            getTexture4(
                x + info.x,
                y + info.y,
                z + info.z
            );

        if (texture != info.rotation) {
            return false;
        }
    }

    // Mod 2 checks second.
    for (int i = 0; i < formationSize; ++i) {

        const RotationInfo info =
            formation[i];

        if (!info.isSide) {
            continue;
        }

        const int texture =
            getTexture2(
                x + info.x,
                y + info.y,
                z + info.z
            );

        if (texture != info.rotation) {
            return false;
        }
    }

    return true;
}


// ============================================================================
// Kernel configuration
// ============================================================================

constexpr int BLOCK_X = 32;
constexpr int BLOCK_Z = 8;


// ============================================================================
// Constant-memory kernel
// ============================================================================

__global__
void searchKernelConstant(
    int y,

    int xMin,
    int xMax,

    int zMin,
    int zMax,

    int formationSize,

    int* __restrict__ resultX,
    int* __restrict__ resultZ,

    unsigned int* __restrict__ resultCount,
    unsigned int maxResults
)
{
    int x =
        xMin
        +
        static_cast<int>(
            blockIdx.x * blockDim.x
            +
            threadIdx.x
        );

    int z =
        zMin
        +
        static_cast<int>(
            blockIdx.y * blockDim.y
            +
            threadIdx.y
        );

    const int xStride =
        static_cast<int>(
            gridDim.x * blockDim.x
        );

    const int zStride =
        static_cast<int>(
            gridDim.y * blockDim.y
        );

    for (
        ;
        z <= zMax;
        z += zStride
    ) {

        for (
            ;
            x <= xMax;
            x += xStride
        ) {

            if (!matchesConstant(
                    x,
                    y,
                    z,
                    formationSize
                )) {

                continue;
            }

            const unsigned int slot =
                atomicAdd(
                    resultCount,
                    1U
                );

            if (slot < maxResults) {

                resultX[slot] = x;
                resultZ[slot] = z;
            }
        }

        // Reset X for next Z row.
        x =
            xMin
            +
            static_cast<int>(
                blockIdx.x * blockDim.x
                +
                threadIdx.x
            );
    }
}


// ============================================================================
// Global-memory fallback kernel
// ============================================================================

__global__
void searchKernelGlobal(
    int y,

    int xMin,
    int xMax,

    int zMin,
    int zMax,

    const RotationInfo* __restrict__ formation,
    int formationSize,

    int* __restrict__ resultX,
    int* __restrict__ resultZ,

    unsigned int* __restrict__ resultCount,
    unsigned int maxResults
)
{
    int x =
        xMin
        +
        static_cast<int>(
            blockIdx.x * blockDim.x
            +
            threadIdx.x
        );

    int z =
        zMin
        +
        static_cast<int>(
            blockIdx.y * blockDim.y
            +
            threadIdx.y
        );

    const int xStride =
        static_cast<int>(
            gridDim.x * blockDim.x
        );

    const int zStride =
        static_cast<int>(
            gridDim.y * blockDim.y
        );

    for (
        ;
        z <= zMax;
        z += zStride
    ) {

        for (
            ;
            x <= xMax;
            x += xStride
        ) {

            if (!matchesGlobal(
                    x,
                    y,
                    z,
                    formation,
                    formationSize
                )) {

                continue;
            }

            const unsigned int slot =
                atomicAdd(
                    resultCount,
                    1U
                );

            if (slot < maxResults) {

                resultX[slot] = x;
                resultZ[slot] = z;
            }
        }

        // Reset X for next Z row.
        x =
            xMin
            +
            static_cast<int>(
                blockIdx.x * blockDim.x
                +
                threadIdx.x
            );
    }
}


// ============================================================================
// Grid configuration
// ============================================================================

static dim3 makeGrid(
    const SearchConfig& config,
    const cudaDeviceProp& props
)
{
    const uint64_t width =
        static_cast<uint64_t>(
            static_cast<int64_t>(config.xMax)
            -
            static_cast<int64_t>(config.xMin)
        ) + static_cast<uint64_t>(1);

    const uint64_t height =
        static_cast<uint64_t>(
            static_cast<int64_t>(config.zMax)
            -
            static_cast<int64_t>(config.zMin)
        ) + static_cast<uint64_t>(1);

    const uint64_t blockX =
        static_cast<uint64_t>(BLOCK_X);

    const uint64_t blockZ =
        static_cast<uint64_t>(BLOCK_Z);

    const uint64_t blocksXNeeded =
        (width + blockX - static_cast<uint64_t>(1))
        / blockX;

    const uint64_t blocksZNeeded =
        (height + blockZ - static_cast<uint64_t>(1))
        / blockZ;


    /*
     * Use approximately 8 blocks per SM.
     */
    uint64_t targetBlocks =
        static_cast<uint64_t>(
            props.multiProcessorCount
        )
        *
        static_cast<uint64_t>(8);


    if (targetBlocks < static_cast<uint64_t>(1)) {
        targetBlocks = static_cast<uint64_t>(1);
    }


    /*
     * Limit X to 256 blocks.
     */
    uint64_t targetX =
        targetBlocks;

    if (targetX > static_cast<uint64_t>(256)) {
        targetX = static_cast<uint64_t>(256);
    }

    if (targetX > blocksXNeeded) {
        targetX = blocksXNeeded;
    }

    if (targetX < static_cast<uint64_t>(1)) {
        targetX = static_cast<uint64_t>(1);
    }


    /*
     * Divide the desired number of blocks between X and Z.
     */
    uint64_t targetZ =
        (
            targetBlocks
            +
            targetX
            -
            static_cast<uint64_t>(1)
        )
        /
        targetX;

    if (targetZ < static_cast<uint64_t>(1)) {
        targetZ = static_cast<uint64_t>(1);
    }


    uint64_t gridX =
        targetX;

    if (gridX > blocksXNeeded) {
        gridX = blocksXNeeded;
    }

    if (gridX < static_cast<uint64_t>(1)) {
        gridX = static_cast<uint64_t>(1);
    }


    uint64_t gridZ =
        targetZ;

    if (gridZ > blocksZNeeded) {
        gridZ = blocksZNeeded;
    }

    if (gridZ < static_cast<uint64_t>(1)) {
        gridZ = static_cast<uint64_t>(1);
    }


    return dim3(
        static_cast<unsigned int>(gridX),
        static_cast<unsigned int>(gridZ),
        1
    );
}

} // namespace
// ============================================================================
// Public launch function
// ============================================================================

void launchSearch(
    int y,

    const SearchConfig& config,

    const RotationInfo* dFormation,
    int formationSize,

    int* dResultX,
    int* dResultZ,

    unsigned int* dResultCount,
    unsigned int maxResults,

    cudaStream_t stream
)
{
    int device = 0;

    cudaGetDevice(&device);

    cudaDeviceProp props{};

    cudaGetDeviceProperties(
        &props,
        device
    );

    const dim3 grid =
        makeGrid(
            config,
            props
        );

    const dim3 block(
        BLOCK_X,
        BLOCK_Z,
        1
    );


    /*
     * Cache the formation in constant memory.
     *
     * The formation normally stays unchanged for the entire search, so this
     * copy happens only once for a given dFormation/formationSize pair.
     */
    if (formationSize <= MAX_CONSTANT_FORMATION) {

        static const RotationInfo* cachedFormation =
            nullptr;

        static int cachedFormationSize =
            -1;


        if (
            cachedFormation != dFormation
            ||
            cachedFormationSize != formationSize
        ) {

            cudaMemcpyToSymbol(
                cFormation,
                dFormation,
                static_cast<size_t>(formationSize)
                *
                sizeof(RotationInfo),
                0,
                cudaMemcpyDeviceToDevice
            );

            cachedFormation =
                dFormation;

            cachedFormationSize =
                formationSize;
        }


        searchKernelConstant<<<
            grid,
            block,
            0,
            stream
        >>>(
            y,

            config.xMin,
            config.xMax,

            config.zMin,
            config.zMax,

            formationSize,

            dResultX,
            dResultZ,

            dResultCount,
            maxResults
        );

    } else {

        /*
         * Large formation fallback.
         */
        searchKernelGlobal<<<
            grid,
            block,
            0,
            stream
        >>>(
            y,

            config.xMin,
            config.xMax,

            config.zMin,
            config.zMax,

            dFormation,
            formationSize,

            dResultX,
            dResultZ,

            dResultCount,
            maxResults
        );
    }
}
